<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Microphone access for AudioRecord -->
    <uses-permission android:name="android.permission.RECORD_AUDIO"/>

    <!-- Required for model download (one-time from GitHub) and LAN POST to FastAPI -->
    <uses-permission android:name="android.permission.INTERNET"/>

    <!-- Used to confirm Wi-Fi connectivity before attempting LAN upload -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE"/>

    <!-- Keeps CPU alive during background recording so the VAD loop is not throttled -->
    <uses-permission android:name="android.permission.WAKE_LOCK"/>

    <application
        android:allowBackup="true"
        android:icon="@android:drawable/sym_def_app_icon"
        android:label="@string/app_name"
        android:roundIcon="@android:drawable/sym_def_app_icon"
        android:supportsRtl="true"
        android:theme="@style/Theme.MaterialComponents.Light.DarkActionBar"
        android:usesCleartextTraffic="true">
        <!--
            usesCleartextTraffic="true" is required for HTTP (not HTTPS) connections
            to the on-premises FastAPI server on hospital LAN.
            The server operates on plain HTTP inside the private network.
        -->

        <activity
            android:name=".LoginActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
        </activity>

        <activity
            android:name=".MainActivity"
            android:exported="false" />

        <activity
            android:name=".NurseActivity"
            android:exported="false"
            android:theme="@style/Theme.MaterialComponents.Light.NoActionBar" />

        <activity
            android:name=".RegisterActivity"
            android:exported="false" />

    </application>

</manifest>
