<?xml version="1.0" encoding="utf-8"?>
<androidx.drawerlayout.widget.DrawerLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/drawerLayout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".MainActivity">

    <!-- ── Main content ──────────────────────────────────────────────────── -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#FAFAFA">

        <!-- ── App title ─────────────────────────────────────────────────── -->
        <TextView
            android:id="@+id/tvAppTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:layout_marginStart="64dp"
            android:layout_marginEnd="16dp"
            android:text="CareVoice AI"
            android:textSize="22sp"
            android:textStyle="bold"
            android:textColor="#1A1A1A"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

        <!-- ── Hamburger menu icon (top-left) ───────────────────────────── -->
        <ImageButton
            android:id="@+id/btnMenu"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_marginTop="16dp"
            android:layout_marginStart="8dp"
            android:src="@android:drawable/ic_menu_sort_by_size"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/drawer_open"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent" />

        <!-- ── Model download progress bar ──────────────────────────────── -->
        <ProgressBar
            android:id="@+id/progressBarDownload"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="0dp"
            android:layout_height="8dp"
            android:layout_marginTop="16dp"
            android:layout_marginStart="24dp"
            android:layout_marginEnd="24dp"
            android:max="100"
            android:progress="0"
            android:visibility="gone"
            android:progressTint="#2196F3"
            app:layout_constraintTop_toBottomOf="@+id/tvAppTitle"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

        <!-- ── Download percentage label ────────────────────────────────── -->
        <TextView
            android:id="@+id/tvDownloadPercent"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text=""
            android:textSize="13sp"
            android:textColor="#555555"
            android:visibility="gone"
            app:layout_constraintTop_toBottomOf="@+id/progressBarDownload"
            app:layout_constraintStart_toStartOf="@+id/progressBarDownload"
            app:layout_constraintEnd_toEndOf="@+id/progressBarDownload" />

        <!-- ── Status label ─────────────────────────────────────────────── -->
        <TextView
            android:id="@+id/tvStatus"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="40dp"
            android:layout_marginStart="24dp"
            android:layout_marginEnd="24dp"
            android:text="Idle"
            android:textSize="18sp"
            android:textColor="#333333"
            android:gravity="center"
            app:layout_constraintTop_toBottomOf="@+id/tvDownloadPercent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

        <!-- ── Amplitude bar ─────────────────────────────────────────────── -->
        <FrameLayout
            android:id="@+id/amplitudeTrack"
            android:layout_width="0dp"
            android:layout_height="24dp"
            android:layout_marginTop="28dp"
            android:layout_marginStart="24dp"
            android:layout_marginEnd="24dp"
            android:background="#E0E0E0"
            app:layout_constraintTop_toBottomOf="@+id/tvStatus"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent">

            <View
                android:id="@+id/viewAmplitudeBar"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:background="#4CAF50" />
        </FrameLayout>

        <!-- ── Call Nurse button ─────────────────────────────────────────── -->
        <Button
            android:id="@+id/btnCallNurse"
            android:layout_width="0dp"
            android:layout_height="64dp"
            android:layout_marginTop="48dp"
            android:layout_marginStart="32dp"
            android:layout_marginEnd="32dp"
            android:text="@string/btn_call_nurse"
            android:textSize="18sp"
            android:textStyle="bold"
            android:enabled="false"
            android:backgroundTint="#2196F3"
            android:textColor="#FFFFFF"
            app:layout_constraintTop_toBottomOf="@+id/amplitudeTrack"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

        <!-- ── Stop button ───────────────────────────────────────────────── -->
        <Button
            android:id="@+id/btnStop"
            android:layout_width="0dp"
            android:layout_height="52dp"
            android:layout_marginTop="16dp"
            android:layout_marginStart="32dp"
            android:layout_marginEnd="32dp"
            android:text="@string/btn_stop"
            android:textSize="16sp"
            android:enabled="false"
            android:backgroundTint="#F44336"
            android:textColor="#FFFFFF"
            app:layout_constraintTop_toBottomOf="@+id/btnCallNurse"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardRequestStatus"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:layout_marginStart="24dp"
            android:layout_marginEnd="24dp"
            android:visibility="gone"
            app:cardCornerRadius="12dp"
            app:cardElevation="2dp"
                        app:layout_constraintTop_toBottomOf="@id/btnStop"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="14dp">

                <TextView
                    android:id="@+id/tvRequestStatusTitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/patient_status_title"
                    android:textStyle="bold"
                    android:textSize="16sp"
                    android:textColor="#1A1A1A"/>

                <TextView
                    android:id="@+id/tvRequestStatusDetail"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="5dp"
                    android:textSize="12sp"
                    android:textColor="#666666"/>

                <TextView
                    android:id="@+id/tvRequestSummary"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:textSize="13sp"
                    android:textColor="#333333"/>

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnPatientAck"
                    android:layout_width="wrap_content"
                    android:layout_height="42dp"
                    android:layout_marginTop="8dp"
                    android:text="@string/patient_ack_button"
                    android:enabled="false"
                    android:visibility="gone"/>

                <TextView
                    android:id="@+id/tvPatientAcked"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="5dp"
                    android:text="@string/patient_status_confirmed"
                    android:textStyle="bold"
                    android:textColor="#2E7D32"
                    android:visibility="gone"/>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <Button
            android:id="@+id/btnSendVoiceNote"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_marginTop="10dp"
            android:layout_marginStart="24dp"
            android:layout_marginEnd="24dp"
            android:text="@string/patient_send_voice_note"
            android:textSize="14sp"
            app:layout_constraintTop_toBottomOf="@id/cardRequestStatus"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardVoiceNote"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:layout_marginStart="24dp"
            android:layout_marginEnd="24dp"
            android:visibility="gone"
            app:cardCornerRadius="12dp"
            app:cardElevation="2dp"
                        app:layout_constraintTop_toBottomOf="@id/btnSendVoiceNote"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="14dp">

                <TextView
                    android:id="@+id/tvVoiceNoteTitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Voice message from nurse"
                    android:textStyle="bold"
                    android:textSize="15sp"
                    android:textColor="#1A1A1A"/>

                <TextView
                    android:id="@+id/tvVoiceNoteInfo"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text=""
                    android:textSize="12sp"
                    android:textColor="#666666"/>

                <Button
                    android:id="@+id/btnPlayVoiceNote"
                    android:layout_width="wrap_content"
                    android:layout_height="44dp"
                    android:layout_marginTop="8dp"
                    android:text="▶ Play voice message"/>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

    </androidx.constraintlayout.widget.ConstraintLayout>

    <!-- ── Navigation drawer (left side) ─────────────────────────────────── -->
    <com.google.android.material.navigation.NavigationView
        android:id="@+id/navView"
        android:layout_width="300dp"
        android:layout_height="match_parent"
        android:layout_gravity="start"
        android:background="@color/colorDrawerBg"
        app:headerLayout="@layout/nav_header"
        app:menu="@menu/drawer_menu"
        app:itemTextColor="@color/colorDrawerItemText"
        app:itemIconTint="@color/colorDrawerItemIcon" />

</androidx.drawerlayout.widget.DrawerLayout>
