<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/colorLoginScreenBg"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:padding="20dp">

        <!-- Recipient -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardBackgroundColor="@color/colorLoginCard"
            app:cardCornerRadius="14dp"
            app:cardElevation="2dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/vn_send_to"
                    android:textColor="@color/colorLoginSubtitle"
                    android:textSize="13sp" />

                <TextView
                    android:id="@+id/tvRecipient"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:textColor="@color/colorLoginTitle"
                    android:textSize="17sp"
                    android:textStyle="bold" />

                <Spinner
                    android:id="@+id/spinnerRoom"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:layout_marginTop="4dp"
                    android:contentDescription="@string/vn_send_to"
                    android:visibility="gone" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:text="@string/vn_language"
                    android:textColor="@color/colorLoginSubtitle"
                    android:textSize="13sp" />

                <com.google.android.material.button.MaterialButtonToggleGroup
                    android:id="@+id/toggleLanguage"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    app:checkedButton="@+id/btnLangEn"
                    app:selectionRequired="true"
                    app:singleSelection="true">

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnLangEn"
                        style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:minHeight="48dp"
                        android:text="@string/vn_lang_english"
                        android:textAllCaps="false" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnLangHi"
                        style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:minHeight="48dp"
                        android:text="@string/vn_lang_hindi"
                        android:textAllCaps="false" />
                </com.google.android.material.button.MaterialButtonToggleGroup>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Recorder -->
        <TextView
            android:id="@+id/tvTimer"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="36dp"
            android:text="0:00 / 0:30"
            android:textColor="@color/colorLoginTitle"
            android:textSize="34sp"
            android:textStyle="bold" />

        <com.google.android.material.floatingactionbutton.FloatingActionButton
            android:id="@+id/fabRecord"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:contentDescription="@string/vn_record"
            android:src="@drawable/ic_vn_mic"
            app:backgroundTint="@color/colorLoginPatientAccent"
            app:fabCustomSize="104dp"
            app:maxImageSize="48dp"
            app:tint="@android:color/white" />

        <TextView
            android:id="@+id/tvStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:gravity="center"
            android:text="@string/vn_tap_to_record"
            android:textColor="@color/colorLoginSubtitle"
            android:textSize="15sp" />

        <!-- Review (shown after a recording is made) -->
        <LinearLayout
            android:id="@+id/reviewRow"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:orientation="vertical"
            android:visibility="gone">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnPreview"
                    style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="6dp"
                    android:layout_weight="1"
                    android:minHeight="52dp"
                    android:text="@string/vn_preview"
                    android:textAllCaps="false"
                    android:textColor="@color/colorLoginPatientAccent"
                    app:cornerRadius="12dp"
                    app:icon="@drawable/ic_vn_play"
                    app:iconTint="@color/colorLoginPatientAccent"
                    app:strokeColor="@color/colorLoginPatientAccent" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnDiscard"
                    style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:layout_weight="1"
                    android:minHeight="52dp"
                    android:text="@string/vn_discard"
                    android:textAllCaps="false"
                    android:textColor="@color/colorPriorityCritical"
                    app:cornerRadius="12dp"
                    app:icon="@drawable/ic_vn_delete"
                    app:iconTint="@color/colorPriorityCritical"
                    app:strokeColor="@color/colorPriorityCritical" />
            </LinearLayout>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnSend"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:minHeight="56dp"
                android:text="@string/vn_send_btn"
                android:textAllCaps="false"
                android:textSize="17sp"
                app:backgroundTint="@color/colorLoginNurseAccent"
                app:cornerRadius="12dp"
                app:icon="@drawable/ic_vn_send" />
        </LinearLayout>
    </LinearLayout>
</ScrollView>
