<?xml version="1.0" encoding="utf-8"?>
<!--
    item_alert.xml — one alert card on the nurse dashboard.

    ┃ [CRITICAL]  Room 4B                         14:32
    ┃ Rajesh Kumar — chest pain, possible cardiac emergency
    ┃ (Emergency) (DISTRESSED)
    ┃ ┌ "I can't breathe properly" ┐
    ┃ ✓ Acknowledged            [Call]  [ACK]
    The coloured strip on the left follows the priority.
-->
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/cardAlert"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="6dp"
    android:layout_marginBottom="6dp"
    app:cardElevation="1dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <View
            android:id="@+id/viewPriorityStrip"
            android:layout_width="6dp"
            android:layout_height="match_parent"
            android:background="@drawable/bg_card_strip" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:paddingStart="14dp"
            android:paddingTop="14dp"
            android:paddingEnd="14dp"
            android:paddingBottom="12dp">

            <!-- Priority · room · time -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/tvPriority"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_priority_badge"
                    android:fontFamily="sans-serif-medium"
                    android:letterSpacing="0.06"
                    android:paddingStart="10dp"
                    android:paddingTop="4dp"
                    android:paddingEnd="10dp"
                    android:paddingBottom="4dp"
                    android:textColor="@color/colorPriorityCritical"
                    android:textSize="11sp" />

                <TextView
                    android:id="@+id/tvRoom"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="10dp"
                    android:layout_weight="1"
                    android:ellipsize="end"
                    android:fontFamily="sans-serif-medium"
                    android:maxLines="1"
                    android:textColor="@color/colorText"
                    android:textSize="17sp" />

                <TextView
                    android:id="@+id/tvTime"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="@color/cv_text_muted"
                    android:textSize="12sp" />
            </LinearLayout>

            <!-- Who + what they need -->
            <TextView
                android:id="@+id/tvSummary"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:fontFamily="sans-serif-medium"
                android:textColor="@color/colorText"
                android:textSize="15sp" />

            <!-- Intent + emotion chips -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/tvIntent"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_pill"
                    android:backgroundTint="@color/cv_primary_soft"
                    android:ellipsize="end"
                    android:fontFamily="sans-serif-medium"
                    android:maxLines="1"
                    android:paddingStart="10dp"
                    android:paddingTop="4dp"
                    android:paddingEnd="10dp"
                    android:paddingBottom="4dp"
                    android:textColor="@color/colorLoginPatientAccent"
                    android:textSize="12sp" />

                <TextView
                    android:id="@+id/tvDistress"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:background="@drawable/bg_pill"
                    android:backgroundTint="@color/colorPriorityUrgentBg"
                    android:fontFamily="sans-serif-medium"
                    android:paddingStart="10dp"
                    android:paddingTop="4dp"
                    android:paddingEnd="10dp"
                    android:paddingBottom="4dp"
                    android:textColor="#92400E"
                    android:textSize="11sp" />
            </LinearLayout>

            <!-- What the patient said -->
            <TextView
                android:id="@+id/tvTranscript"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:background="@drawable/bg_quote"
                android:ellipsize="end"
                android:maxLines="3"
                android:padding="10dp"
                android:textColor="@color/colorTextSecondary"
                android:textSize="13sp"
                android:textStyle="italic" />

            <!-- Actions -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/tvAckedBy"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:drawableStart="@drawable/ic_cv_check"
                    android:drawablePadding="4dp"
                    android:drawableTint="@color/colorAcknowledged"
                    android:fontFamily="sans-serif-medium"
                    android:gravity="center_vertical"
                    android:textColor="@color/colorAcknowledged"
                    android:textSize="13sp"
                    android:visibility="gone" />

                <Space
                    android:layout_width="0dp"
                    android:layout_height="1dp"
                    android:layout_weight="1" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnCall"
                    style="@style/Widget.CareVoice.Button.Outlined"
                    android:layout_width="wrap_content"
                    android:layout_height="48dp"
                    android:layout_marginEnd="8dp"
                    android:text="@string/call_patient"
                    android:textColor="@color/colorLoginNurseAccent"
                    android:textSize="13sp"
                    app:icon="@drawable/ic_cv_phone"
                    app:iconSize="16dp"
                    app:iconTint="@color/colorLoginNurseAccent"
                    app:strokeColor="@color/colorLoginNurseAccent" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnAck"
                    android:layout_width="wrap_content"
                    android:layout_height="48dp"
                    android:text="@string/nurse_ack"
                    android:textSize="13sp"
                    app:backgroundTint="@color/colorLoginNurseAccent"
                    app:icon="@drawable/ic_cv_check"
                    app:iconSize="16dp" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
