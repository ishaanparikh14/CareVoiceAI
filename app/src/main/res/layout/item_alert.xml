<?xml version="1.0" encoding="utf-8"?>
<!--
    item_alert.xml — single alert card in the nurse dashboard RecyclerView.

    Visual structure:
    ┌─────────────────────────────────────────────────────┐
    │ [CRITICAL]  Room 4B                    14:32  ✓ ACK │
    │ Pain                      distress 0.87             │
    │ "I need help, my leg hurts badly"                   │
    └─────────────────────────────────────────────────────┘
-->
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/cardAlert"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="12dp"
    android:layout_marginVertical="6dp"
    app:cardCornerRadius="10dp"
    app:cardElevation="3dp"
    app:cardBackgroundColor="@color/colorCardBackground">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingHorizontal="14dp"
        android:paddingTop="12dp"
        android:paddingBottom="10dp">

        <!-- Priority badge — coloured pill (CRITICAL / URGENT / ROUTINE) -->
        <TextView
            android:id="@+id/tvPriority"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:paddingHorizontal="10dp"
            android:paddingVertical="3dp"
            android:textSize="11sp"
            android:textStyle="bold"
            android:textColor="@color/colorPriorityCritical"
            android:background="@drawable/bg_priority_badge"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent"/>

        <!-- Room ID — bold, prominent -->
        <TextView
            android:id="@+id/tvRoom"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:textSize="16sp"
            android:textStyle="bold"
            android:textColor="@color/colorText"
            app:layout_constraintTop_toTopOf="@id/tvPriority"
            app:layout_constraintBottom_toBottomOf="@id/tvPriority"
            app:layout_constraintStart_toEndOf="@id/tvPriority"
            app:layout_constraintEnd_toStartOf="@id/tvTime"/>

        <!-- Timestamp — right-aligned -->
        <TextView
            android:id="@+id/tvTime"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textSize="12sp"
            android:textColor="@color/colorTextSecondary"
            app:layout_constraintTop_toTopOf="@id/tvPriority"
            app:layout_constraintBottom_toBottomOf="@id/tvPriority"
            app:layout_constraintEnd_toEndOf="parent"/>

        <!-- Intent label + distress score, second row -->
        <TextView
            android:id="@+id/tvIntent"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:textSize="13sp"
            android:textColor="@color/colorTextSecondary"
            app:layout_constraintTop_toBottomOf="@id/tvPriority"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toStartOf="@id/tvDistress"/>

        <TextView
            android:id="@+id/tvDistress"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:textSize="12sp"
            android:textColor="@color/colorTextSecondary"
            app:layout_constraintTop_toBottomOf="@id/tvTime"
            app:layout_constraintEnd_toEndOf="parent"/>

        <!-- Transcript — italic, up to 2 lines -->
        <TextView
            android:id="@+id/tvTranscript"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:textSize="14sp"
            android:textColor="@color/colorText"
            android:fontFamily="sans-serif"
            android:maxLines="2"
            android:ellipsize="end"
            app:layout_constraintTop_toBottomOf="@id/tvIntent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"/>

        <!-- Call patient button — real-time WebRTC voice call -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnCall"
            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:layout_marginTop="10dp"
            android:layout_marginEnd="8dp"
            android:text="@string/call_patient"
            android:textSize="13sp"
            android:paddingHorizontal="16dp"
            app:strokeColor="@color/colorLoginNurseAccent"
            app:layout_constraintTop_toBottomOf="@id/tvTranscript"
            app:layout_constraintEnd_toStartOf="@id/btnAck"
            app:layout_constraintBottom_toBottomOf="parent"/>

        <!-- ACK button — right-aligned below transcript -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnAck"
            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:layout_marginTop="10dp"
            android:text="@string/nurse_ack"
            android:textSize="13sp"
            android:paddingHorizontal="16dp"
            app:strokeColor="@color/colorPrimary"
            app:layout_constraintTop_toBottomOf="@id/tvTranscript"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"/>

        <!-- "Acknowledged by …" label — shown instead of ACK button -->
        <TextView
            android:id="@+id/tvAckedBy"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:layout_marginEnd="8dp"
            android:textSize="12sp"
            android:textColor="@color/colorAcknowledged"
            android:visibility="gone"
            app:layout_constraintTop_toBottomOf="@id/tvTranscript"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toStartOf="@id/btnAck"
            app:layout_constraintBottom_toBottomOf="parent"/>

    </androidx.constraintlayout.widget.ConstraintLayout>

</com.google.android.material.card.MaterialCardView>
