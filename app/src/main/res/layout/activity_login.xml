<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/scrollRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="@color/colorLoginScreenBg">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <!-- ── Gradient header ────────────────────────────────────────── -->
        <View
            android:id="@+id/viewHeaderBg"
            android:layout_width="0dp"
            android:layout_height="260dp"
            android:background="@drawable/bg_login_header_patient"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <!-- App name small label -->
        <TextView
            android:id="@+id/tvAppLabel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="28dp"
            android:layout_marginTop="52dp"
            android:text="@string/app_name"
            android:textColor="#FFFFFF"
            android:alpha="0.75"
            android:textSize="11sp"
            android:letterSpacing="0.18"
            android:textAllCaps="true"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <!-- Main title -->
        <TextView
            android:id="@+id/tvLoginTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="28dp"
            android:layout_marginEnd="28dp"
            android:layout_marginTop="6dp"
            android:text="@string/login_title_patient"
            android:textColor="#FFFFFF"
            android:textSize="32sp"
            android:textStyle="bold"
            android:lineSpacingMultiplier="1.1"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toBottomOf="@id/tvAppLabel" />

        <!-- Subtitle -->
        <TextView
            android:id="@+id/tvLoginSub"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="28dp"
            android:layout_marginTop="4dp"
            android:text="@string/login_subtitle_patient"
            android:textColor="#FFFFFF"
            android:alpha="0.82"
            android:textSize="14sp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/tvLoginTitle" />

        <!-- ── Role toggle chips ───────────────────────────────────────── -->
        <!--
             Both chips: white pill background (fully opaque when selected,
             30% opacity when idle). Text is always dark → readable against
             any gradient at both states without any runtime color switching.
        -->
        <com.google.android.material.chip.ChipGroup
            android:id="@+id/chipGroupRole"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="28dp"
            android:layout_marginTop="18dp"
            app:singleSelection="true"
            app:selectionRequired="true"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/tvLoginSub">

            <com.google.android.material.chip.Chip
                android:id="@+id/chipPatient"
                style="@style/Widget.MaterialComponents.Chip.Choice"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/login_tab_patient"
                android:textColor="#1A1A1A"
                android:textStyle="bold"
                android:textSize="13sp"
                android:checked="true"
                app:chipBackgroundColor="@color/chip_bg_selector"
                app:chipStrokeColor="@android:color/transparent"
                app:chipStrokeWidth="0dp"
                app:checkedIconVisible="false"
                app:chipMinHeight="36dp" />

            <com.google.android.material.chip.Chip
                android:id="@+id/chipNurse"
                style="@style/Widget.MaterialComponents.Chip.Choice"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/login_tab_nurse"
                android:textColor="#1A1A1A"
                android:textStyle="bold"
                android:textSize="13sp"
                android:checked="false"
                app:chipBackgroundColor="@color/chip_bg_selector"
                app:chipStrokeColor="@android:color/transparent"
                app:chipStrokeWidth="0dp"
                app:checkedIconVisible="false"
                app:chipMinHeight="36dp" />

        </com.google.android.material.chip.ChipGroup>

        <!-- ── White card ─────────────────────────────────────────────── -->
        <androidx.cardview.widget.CardView
            android:id="@+id/cardForm"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="20dp"
            android:layout_marginEnd="20dp"
            android:layout_marginTop="-36dp"
            app:cardCornerRadius="20dp"
            app:cardElevation="12dp"
            app:cardBackgroundColor="@color/colorLoginCard"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/viewHeaderBg">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingStart="24dp"
                android:paddingEnd="24dp"
                android:paddingTop="28dp"
                android:paddingBottom="28dp">

                <!-- "Sign in as X" label -->
                <TextView
                    android:id="@+id/tvRoleLabel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="22dp"
                    android:text="Sign in as Patient"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    android:textColor="@color/colorLoginTitle" />

                <!-- Username -->
                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/tilUsername"
                    style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="@string/login_hint_username"
                    app:hintTextColor="@color/colorLoginFieldHint"
                    app:boxStrokeColor="@color/colorLoginFieldStroke">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/etUsername"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="text"
                        android:imeOptions="actionNext"
                        android:textColor="@color/colorLoginFieldText" />
                </com.google.android.material.textfield.TextInputLayout>

                <!-- Password -->
                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/tilPassword"
                    style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:hint="@string/login_hint_password"
                    app:endIconMode="password_toggle"
                    app:hintTextColor="@color/colorLoginFieldHint"
                    app:boxStrokeColor="@color/colorLoginFieldStroke">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/etPassword"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="textPassword"
                        android:imeOptions="actionDone"
                        android:textColor="@color/colorLoginFieldText" />
                </com.google.android.material.textfield.TextInputLayout>

                <!-- Server URL (nurse only) -->
                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/tilServerUrl"
                    style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:hint="@string/login_server_hint"
                    android:visibility="gone"
                    app:hintTextColor="@color/colorLoginFieldHint"
                    app:boxStrokeColor="@color/colorLoginFieldStroke">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/etServerUrl"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="textUri"
                        android:imeOptions="actionDone"
                        android:textColor="@color/colorLoginFieldText" />
                </com.google.android.material.textfield.TextInputLayout>

                <!-- Sign in button -->
                <Button
                    android:id="@+id/btnLogin"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:layout_marginTop="26dp"
                    android:text="@string/login_btn"
                    android:textStyle="bold"
                    android:textSize="15sp"
                    android:textColor="#FFFFFF"
                    app:cornerRadius="12dp" />

                <!-- Loading spinner (overlays button) -->
                <ProgressBar
                    android:id="@+id/pbLogin"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center_horizontal"
                    android:layout_marginTop="-46dp"
                    android:visibility="gone"
                    android:indeterminateTint="#FFFFFF" />

                <!-- Register link -->
                <TextView
                    android:id="@+id/tvRegister"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center_horizontal"
                    android:layout_marginTop="16dp"
                    android:text="New here? Create an account"
                    android:textSize="13sp"
                    android:textColor="@color/colorLoginPatientAccent"
                    android:textStyle="bold" />

            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <!-- Bottom breathing room -->
        <View
            android:layout_width="0dp"
            android:layout_height="48dp"
            app:layout_constraintTop_toBottomOf="@id/cardForm"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintBottom_toBottomOf="parent" />

    </androidx.constraintlayout.widget.ConstraintLayout>

</androidx.core.widget.NestedScrollView>
