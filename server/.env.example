# .env.example — copy to .env and edit for your deployment
#
#   cp .env.example .env
#
# The server reads these on startup via pydantic-settings.
# Any variable left commented uses the default from config.py.
# NEVER commit your real .env — it is gitignored.

# ── Server ────────────────────────────────────────────────────────────────────
# HOST=0.0.0.0
# PORT=8000
# LOG_LEVEL=info

# ── Pipeline ──────────────────────────────────────────────────────────────────
# true  = stubbed pipeline (no ML, for quick UI testing)
# false = real ASR + intent pipeline (requires trained model in storage/models/)
USE_STUB=false

# Whisper ASR overrides (optional)
# WHISPER_MODEL=small
# WHISPER_DEVICE=cuda        # or cpu

# ── PostgreSQL (users + patients) ─────────────────────────────────────────────
# PG_HOST=localhost
# PG_PORT=5432
# PG_USER=postgres
PG_PASSWORD=change-me
# PG_DATABASE=carevoice

# ── Security (CHANGE THESE IN PRODUCTION) ─────────────────────────────────────
# Generate a key with:  python -c "import secrets; print(secrets.token_hex(32))"
# SECRET_KEY=your-long-random-secret
# NURSE_ADMIN_KEY=your-nurse-signup-key

# ── Storage ───────────────────────────────────────────────────────────────────
# WAV_TEMP_DIR=/data/carevoice/wav_temp
# DB_PATH=/data/carevoice/carevoice.db

# ── CORS ──────────────────────────────────────────────────────────────────────
# Restrict to specific ward IPs in production, e.g.:
# CORS_ORIGINS=["http://192.168.1.20","http://192.168.1.21"]
