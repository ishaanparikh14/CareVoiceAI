# .env.example — copy to .env and edit for your deployment
#
#   cp .env.example .env
#
# ⚠️  SECURITY WARNING ⚠️
# -----------------------
# This file contains SAMPLE values for development. For production:
# 1. Generate cryptographically secure keys (see commands below)
# 2. Never use default passwords like "postgres" or "change-me"
# 3. Never commit your real .env file — it is gitignored
# 4. Use environment variables or secret management in production
#
# The server reads these on startup via pydantic-settings.
# Any variable left commented uses the default from config.py.

# ── Server ────────────────────────────────────────────────────────────────────
# HOST=0.0.0.0
# PORT=8000
# LOG_LEVEL=info

# ── Pipeline ──────────────────────────────────────────────────────────────────
# true  = stubbed pipeline (no ML, for quick UI testing)
# false = real ASR + intent pipeline (requires trained model in storage/models/)
USE_STUB=false

# Whisper ASR overrides (optional)
# WHISPER_MODEL=small
# WHISPER_DEVICE=cuda        # or cpu

# ── PostgreSQL (users + patients) ─────────────────────────────────────────────
# For local development with PostgreSQL:
# PG_HOST=localhost
# PG_PORT=5432
# PG_USER=postgres
# ⚠️  WARNING: Change this to a strong password in production!
PG_PASSWORD=change-me
# PG_DATABASE=carevoice

# For cloud deployments (Neon, AWS RDS, etc.), use DATABASE_URL_OVERRIDE instead:
# DATABASE_URL_OVERRIDE=postgresql://user:strong-password@ep-xxx.aws.neon.tech/carevoice?sslmode=require

# ── Security (MUST BE SET FOR PRODUCTION) ────────────────────────────────────
# ⚠️  CRITICAL: These values MUST be set in production or the server will fail!
#
# Generate cryptographically secure keys:
#   Windows PowerShell:  python -c "import secrets; print(secrets.token_hex(32))"
#   Linux/macOS:         python3 -c "import secrets; print(secrets.token_hex(32))"
#
# SECRET_KEY is used for JWT token signing. Without it, authentication fails.
# NURSE_ADMIN_KEY is required for nurse registration. Without it, nurses can't register.
#
SECRET_KEY=your-64-character-hex-secret-generated-with-secrets-token_hex-32
NURSE_ADMIN_KEY=your-nurse-signup-key-also-generated-with-secrets-token_hex-32

# ── Storage ───────────────────────────────────────────────────────────────────
# WAV_TEMP_DIR=/data/carevoice/wav_temp
# DB_PATH=/data/carevoice/carevoice.db

# ── CORS (Cross-Origin Resource Sharing) ─────────────────────────────────────
# ⚠️  SECURITY: Restrict origins in production to prevent unauthorized access
#
# Note: If CORS_ORIGINS is empty or not set, the server will allow all origins
# but log a security warning. Explicitly set origins for production.
#
# For local development with the Android app and web dashboard:
# CORS_ORIGINS=["http://localhost:8000", "http://192.168.1.100:8000"]
#
# For production with HTTPS:
# CORS_ORIGINS=["https://your-domain.com", "https://nurse-dashboard.your-domain.com"]
#
# Explicitly allow all origins (development only - NOT RECOMMENDED for production):
# CORS_ORIGINS=["*"]

# ── Deployment Environment Guide ──────────────────────────────────────────────
#
# Development (local testing):
# - USE_STUB=false (or true for quick UI testing without ML)
# - PG_PASSWORD=your-local-db-password
# - CORS_ORIGINS=["http://localhost:8000", "http://192.168.1.*:8000"]
# - Generate SECRET_KEY and NURSE_ADMIN_KEY but they can be simple for dev
#
# Production (Modal cloud deployment):
# - USE_STUB=false (always use real pipeline)
# - DATABASE_URL_OVERRIDE=neon-postgres-url-with-ssl
# - SECRET_KEY=cryptographically-secure-64-hex-chars
# - NURSE_ADMIN_KEY=cryptographically-secure-64-hex-chars  
# - CORS_ORIGINS=["https://your-production-domain.com"]
#
# The server will log warnings if critical security values are missing.